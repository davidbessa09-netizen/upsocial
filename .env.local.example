# ============================================================
# UP SOCIAL — Variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores reais.
# NUNCA commite .env.local (já está no .gitignore).
# ============================================================

# --- Supabase ---
# URL e chave pública (anon) do seu projeto Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Chave secreta (service role) — usada SOMENTE em código de servidor
# (route handlers, server actions). NUNCA expor no client.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="UP SOCIAL"

# --- Mercado Pago (gateway de pagamento principal) ---
MERCADOPAGO_ACCESS_TOKEN=your_mercadopago_access_token
MERCADOPAGO_PUBLIC_KEY=your_mercadopago_public_key
# Mesma Public Key acima, mas exposta ao browser (necessária para o SDK
# de tokenização de cartão rodar no client). Public Key é segura de expor.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=your_mercadopago_public_key
MERCADOPAGO_WEBHOOK_SECRET=your_mercadopago_webhook_secret

# --- Fornecedor SMM (mock por padrão em desenvolvimento) ---
# Trocar SUPPLIER_MODE para "real" quando tiver um fornecedor de produção.
SUPPLIER_MODE=mock
SUPPLIER_API_URL=https://provider-api.example.com
SUPPLIER_API_KEY=your_supplier_api_key

# --- Segurança ---
# Chave usada para criptografar credenciais sensíveis (ex: api_key de fornecedores) no banco
ENCRYPTION_SECRET=generate_a_random_32_byte_secret_here
